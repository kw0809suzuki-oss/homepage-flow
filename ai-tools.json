{
  "schema": "flow-world-ai-tools-v0",
  "updated_at": "2026-10-07",
  "purpose": "Machine-readable definitions for public Flow World tools that an AI can understand and reproduce without a server API.",
  "tools": [
    {
      "id": "ab-comparator",
      "version": "v0",
      "status": "available",
      "implementation": "tools/ab-compare.js",
      "human_ui": "#workbench",
      "input": {
        "a": {
          "type": "number[]",
          "required": true,
          "description": "Non-empty finite numeric list."
        },
        "b": {
          "type": "number[]",
          "required": true,
          "description": "Non-empty finite numeric list with the same length as a."
        }
      },
      "preconditions": [
        "a and b are arrays",
        "a and b are non-empty",
        "a and b have the same length",
        "all values are finite numbers"
      ],
      "operation": {
        "point_deltas": "a[i] - b[i]",
        "mean_a": "sum(a) / length(a)",
        "mean_b": "sum(b) / length(b)",
        "mean_delta_a_minus_b": "sum(point_deltas) / length(point_deltas)"
      },
      "output": {
        "ok": "boolean",
        "n": "integer when ok",
        "mean_a": "number when ok",
        "mean_b": "number when ok",
        "mean_delta_a_minus_b": "number when ok",
        "point_deltas": "number[] when ok",
        "boundary": "string when ok",
        "error": "string when not ok"
      },
      "boundary": [
        "Reports observed numeric differences only.",
        "Does not establish causality.",
        "Does not decide which side is better without an external objective."
      ],
      "example": {
        "input": {
          "a": [
            10,
            12,
            9
          ],
          "b": [
            8,
            13,
            7
          ]
        },
        "output": {
          "ok": true,
          "n": 3,
          "mean_a": 10.333333333333334,
          "mean_b": 9.333333333333334,
          "mean_delta_a_minus_b": 1,
          "point_deltas": [
            2,
            -1,
            2
          ],
          "boundary": "difference only; no causal claim."
        }
      },
      "compatibility": {
        "read_only_ai": "supported: reproduce from operation definition",
        "javascript_ai": "supported: execute tools/ab-compare.js",
        "browser_operator": "supported: use #workbench UI"
      }
    },
    {
      "id": "static-handoff-play",
      "version": "v0",
      "status": "available",
      "implementation": [
        "play/index.html",
        "play/play.js"
      ],
      "human_ui": "play/",
      "input": {
        "type": {
          "const": "markdown"
        },
        "data": {
          "type": "string",
          "encoding": "UTF-8 Base64URL"
        }
      },
      "url_contract": "play/#type=markdown&data=<UTF-8 Base64URL>",
      "operation": [
        "Read only the URL fragment after #.",
        "Require type=markdown.",
        "Decode data as UTF-8 Base64URL.",
        "Render a small safe Markdown subset locally in the browser.",
        "Do not send or persist the payload server-side."
      ],
      "supported_markdown": [
        "headings levels 1-3",
        "paragraphs",
        "unordered lists",
        "blockquotes",
        "inline code",
        "fenced code blocks",
        "bold",
        "italic"
      ],
      "boundary": [
        "No server storage.",
        "No API call is required.",
        "Only markdown is supported in v0.",
        "Raw HTML is escaped and not executed.",
        "The fragment may remain visible in browser history or be shared with the URL; do not place secrets in it."
      ],
      "compatibility": {
        "read_only_ai": "supported for URL construction if Base64URL encoding is available; opening/rendering may be delegated to the human",
        "javascript_ai": "supported",
        "browser_operator": "supported"
      }
    }
  ],
  "compatibility_policy": {
    "baseline": "read-only static web access",
    "execution_preference": [
      "reproduce deterministic operation from this file",
      "use shared JavaScript implementation when executable",
      "use human browser UI only when interaction is available"
    ],
    "unavailable_capability_rule": "If the environment cannot perform a listed interaction, report the boundary and use a lower-capability path when one exists."
  }
}
